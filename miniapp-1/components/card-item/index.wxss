.info-card { display: flex; margin-bottom: 16rpx; overflow: hidden; background: #fff; border: 1rpx solid #e3ece9; border-radius: 16rpx; box-shadow: 0 1rpx 2rpx rgba(20, 50, 54, .04); }
.info-card:active { background: #f8fbfa; }
.cover-wrap { width: 174rpx; min-height: 218rpx; flex-shrink: 0; background: #edf4f2; }
.cover { width: 100%; height: 100%; min-height: 218rpx; display: block; }
.card-main { flex: 1; min-width: 0; padding: 20rpx; }
.meta-row { display: flex; align-items: center; min-width: 0; margin-bottom: 12rpx; color: #8996a8; font-size: 20rpx; }
.category { flex-shrink: 0; margin-right: 10rpx; padding: 4rpx 10rpx; color: #187c68; background: #e5f6f0; border-radius: 999rpx; font-size: 19rpx; font-weight: 600; }
.category-competition { color: #6d28d9; background: #f0eaff; }
.category-recruit { color: #b45309; background: #fff2d8; }
.category-academic { color: #0369a1; background: #e0f2fe; }
.category-certification, .category-teacher-cert { color: #047857; background: #dcfce7; }
.category-sports { color: #c2410c; background: #ffedd5; }
.category-notice { color: #187c68; background: #e5f6f0; }
.source { max-width: 180rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.dot { margin: 0 7rpx; }
.time { flex-shrink: 0; }
.title { display: -webkit-box; overflow: hidden; color: #18323a; font-size: 28rpx; line-height: 1.42; font-weight: 650; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.summary { display: -webkit-box; overflow: hidden; margin-top: 11rpx; color: #71858a; font-size: 23rpx; line-height: 1.55; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.action-hint { display: -webkit-box; overflow: hidden; margin-top: 10rpx; color: #187c68; font-size: 22rpx; line-height: 1.45; -webkit-box-orient: vertical; -webkit-line-clamp: 1; }
.card-bottom { display: flex; align-items: flex-end; justify-content: space-between; margin-top: 18rpx; gap: 14rpx; }
.tags { flex: 1; min-width: 0; display: flex; gap: 10rpx; overflow: hidden; white-space: nowrap; }
.tag { color: #78879b; font-size: 20rpx; }
.favorite { display: flex; align-items: center; flex-shrink: 0; gap: 5rpx; color: #7b8798; font-size: 21rpx; }
.favorite.active { color: #187c68; }
.favorite-icon { font-size: 28rpx; line-height: 1; }
@media (max-width: 375px) {
  .cover-wrap { width: 168rpx; }
  .card-main { padding: 18rpx; }
  .title { font-size: 27rpx; }
}
