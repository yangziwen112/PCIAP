.notice-banner {
  margin: 8px 16px;
}
.notice-item {
  background: #FFF7ED;
  color: #C2410C;
  border-radius: 10px;
  padding: 8px 12px;
  display: flex;
  align-items: center;
}
.notice-item .tag {
  background: #FDBA74;
  color: #7C2D12;
  border-radius: 6px;
  padding: 2px 6px;
  font-size: 12px;
  margin-right: 8px;
}
.notice-item .title {
  font-size: 14px;
  font-weight: 500;
  flex: 1;
} 