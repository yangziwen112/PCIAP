.page-profile {
  min-height: 100vh;
  background: #f5f8f7;
  padding-bottom: 40rpx;
}
.profile-header {
  margin: 0 0 20rpx;
  padding: 44rpx 32rpx 32rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #e3ece9;
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.page-profile .avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #e5f6f0;
}
.user-info { flex: 1; }
.nickname { font-size: 34rpx; font-weight: 650; color: #10282f; }
.sub { margin-top: 6rpx; font-size: 24rpx; color: #71858a; }
.login-btn {
  background: #187c68;
  color: #ffffff;
  border: none;
  border-radius: 999rpx;
}
.menu-card {
  margin: 0 32rpx 24rpx;
  background: #ffffff;
  border: 1rpx solid #e3ece9;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 1rpx 2rpx rgba(20, 50, 54, .04);
}
.cell {
  min-height: 96rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  border-bottom: 1rpx solid #eef3f1;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.cell:last-child { border-bottom: none; }
.cell-text { font-size: 28rpx; color: #18323a; }
.admin-cell { background: #f8fbfa; }
.admin-badge { margin-left: auto; margin-right: 12rpx; padding: 4rpx 10rpx; color: #187c68; background: #e5f6f0; border-radius: 999rpx; font-size: 19rpx; }
.logout-text { color: #c96f61; }
.cell-arrow { font-size: 32rpx; color: #99a7aa; }
