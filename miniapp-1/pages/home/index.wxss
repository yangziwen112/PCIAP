.page-home {
  min-height: 100vh;
  padding-bottom: 40rpx;
  background: #f5f8f7;
  color: #18323a;
}

.page-home.page-ready .home-header,
.page-home.page-ready .search-box,
.page-home.page-ready .focus-card,
.page-home.page-ready .upcoming-panel,
.page-home.page-ready .feed-panel {
  animation: pageEnter 220ms ease-out both;
}

.page-home.reduced-motion .home-header,
.page-home.reduced-motion .search-box,
.page-home.reduced-motion .focus-card,
.page-home.reduced-motion .upcoming-panel,
.page-home.reduced-motion .feed-panel,
.page-home.reduced-motion .refresh-action {
  animation: none;
  transition: none;
}

@keyframes pageEnter {
  from { opacity: 0; transform: translateY(12rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.home-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 44rpx 32rpx 28rpx;
  background: #f5f8f7;
}

.eyebrow {
  display: block;
  color: #71858a;
  font-size: 22rpx;
  letter-spacing: 1rpx;
}

.brand-title {
  display: block;
  margin-top: 8rpx;
  color: #10282f;
  font-size: 52rpx;
  line-height: 1.1;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.brand-subtitle {
  display: block;
  margin-top: 10rpx;
  color: #71858a;
  font-size: 24rpx;
}

.refresh-action {
  width: 68rpx;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #187c68;
  background: #e5f6f0;
  border: 1rpx solid #cbeadd;
  border-radius: 50%;
  font-size: 36rpx;
}

.refresh-action:active { transform: scale(.95); }
.rotating { opacity: .55; }

.search-box {
  height: 84rpx;
  display: flex;
  align-items: center;
  margin: 0 32rpx 24rpx;
  padding: 0 22rpx;
  box-sizing: border-box;
  background: #ffffff;
  border: 1rpx solid #e3ece9;
  border-radius: 18rpx;
  box-shadow: 0 1rpx 2rpx rgba(20, 50, 54, .04);
}

.search-icon { margin-right: 14rpx; color: #71858a; font-size: 34rpx; }
.search-input { flex: 1; min-width: 0; height: 84rpx; color: #18323a; font-size: 27rpx; }
.clear-search { padding: 14rpx; color: #99a7aa; font-size: 32rpx; }

.focus-card {
  margin: 0 32rpx 28rpx;
  padding: 28rpx;
  background: #ffffff;
  border: 1rpx solid #e3ece9;
  border-radius: 20rpx;
  box-shadow: 0 1rpx 2rpx rgba(20, 50, 54, .04);
}

.focus-kicker { display: block; color: #187c68; font-size: 22rpx; font-weight: 600; }
.focus-title { display: block; margin-top: 10rpx; color: #10282f; font-size: 34rpx; line-height: 1.3; font-weight: 650; }
.focus-desc { display: block; margin-top: 8rpx; color: #71858a; font-size: 23rpx; line-height: 1.55; }

.primary-action {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 78rpx;
  margin-top: 24rpx;
  padding: 0 22rpx;
  box-sizing: border-box;
  color: #ffffff;
  background: #187c68;
  border-radius: 14rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.primary-action:active { background: #126553; transform: translateY(1rpx); }
.primary-action text { font-size: 32rpx; }

.secondary-actions { display: flex; gap: 28rpx; margin-top: 20rpx; }
.secondary-action { color: #5682b4; font-size: 23rpx; }
.secondary-action text { margin-left: 4rpx; }
.secondary-action:active { opacity: .6; }

.upcoming-panel,
.feed-panel {
  margin: 0 32rpx 24rpx;
  background: #ffffff;
  border: 1rpx solid #e3ece9;
  border-radius: 20rpx;
  box-shadow: 0 1rpx 2rpx rgba(20, 50, 54, .04);
}

.upcoming-panel { padding: 26rpx 0 26rpx 24rpx; }
.feed-panel { padding: 26rpx 24rpx; }
.section-heading { display: flex; align-items: flex-start; justify-content: space-between; padding-right: 24rpx; }
.section-title { display: block; color: #10282f; font-size: 30rpx; line-height: 1.35; font-weight: 650; }
.section-caption { display: block; margin-top: 7rpx; color: #71858a; font-size: 21rpx; line-height: 1.5; }

.upcoming-scroll { margin-top: 20rpx; white-space: nowrap; }
.upcoming-card {
  display: inline-flex;
  flex-direction: column;
  width: 318rpx;
  min-height: 196rpx;
  margin-right: 14rpx;
  padding: 20rpx;
  box-sizing: border-box;
  vertical-align: top;
  background: #f8fbfa;
  border: 1rpx solid #dcebe6;
  border-radius: 16rpx;
}

.upcoming-card:active { background: #eef8f4; }
.upcoming-meta { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }
.upcoming-category { color: #187c68; font-size: 21rpx; font-weight: 650; }
.upcoming-label { padding: 4rpx 10rpx; color: #a06b1b; background: #fff3d9; border-radius: 999rpx; font-size: 19rpx; }
.upcoming-title { margin-top: 16rpx; color: #18323a; font-size: 26rpx; line-height: 1.45; font-weight: 650; white-space: normal; }
.upcoming-time { margin-top: 13rpx; color: #187c68; font-size: 22rpx; }
.upcoming-source { margin-top: 8rpx; overflow: hidden; color: #71858a; font-size: 20rpx; text-overflow: ellipsis; white-space: nowrap; }

.category-scroll { margin: 22rpx -24rpx 20rpx; padding: 0 24rpx; white-space: nowrap; }
.category-chip { display: inline-flex; align-items: center; height: 56rpx; margin-right: 10rpx; padding: 0 20rpx; color: #71858a; background: #f5f8f7; border: 1rpx solid #e3ece9; border-radius: 999rpx; font-size: 23rpx; }
.category-chip.active { color: #187c68; background: #e5f6f0; border-color: #bfe4d7; font-weight: 600; }

.skeleton-card { height: 232rpx; margin-bottom: 16rpx; border-radius: 16rpx; }
.load-more { padding: 22rpx 0 6rpx; color: #99a7aa; text-align: center; font-size: 22rpx; }
.load-more.tappable { color: #187c68; }
.empty-state { display: flex; flex-direction: column; align-items: center; padding: 62rpx 20rpx 56rpx; }
.empty-mark { width: 60rpx; height: 60rpx; display: flex; align-items: center; justify-content: center; color: #5682b4; background: #edf4fc; border-radius: 50%; font-family: Georgia, serif; font-size: 34rpx; font-weight: 700; }
.empty-title { margin-top: 18rpx; color: #18323a; font-size: 26rpx; font-weight: 650; }
.empty-desc { margin-top: 8rpx; color: #71858a; font-size: 22rpx; text-align: center; }

@media (prefers-reduced-motion: reduce) {
  .refresh-action,
  .primary-action { transition: none; }
}
