<view class="page-home {{pageReady ? 'page-ready' : ''}} {{lowPerformance ? 'reduced-motion' : ''}}">
  <view class="home-header">
    <view>
      <text class="eyebrow">校园信息聚合</text>
      <text class="brand-title">民大通</text>
      <text class="brand-subtitle">先看清来源，再决定下一步</text>
    </view>
    <view class="refresh-action {{refreshing ? 'rotating' : ''}}" bindtap="refreshData" aria-label="刷新资讯">↻</view>
  </view>

  <view class="search-box">
    <text class="search-icon">⌕</text>
    <input
      class="search-input"
      value="{{searchKeyword}}"
      placeholder="搜索通知、活动或竞赛"
      confirm-type="search"
      bindinput="onSearchInput"
      bindconfirm="onSearch"
    />
    <text class="clear-search" wx:if="{{searchKeyword}}" bindtap="clearSearch">×</text>
  </view>

  <view class="focus-card">
    <view class="focus-copy">
      <text class="focus-kicker">现在需要什么</text>
      <text class="focus-title">让助手帮你先查清楚</text>
      <text class="focus-desc">基于公开资讯回答，来源和时间会一起展示。</text>
    </view>
    <view class="primary-action" bindtap="goToAssistant">打开智能助手 <text>→</text></view>
    <view class="secondary-actions">
      <view class="secondary-action" bindtap="goToCampusWall">校园动态 <text>→</text></view>
      <view class="secondary-action" bindtap="goToSubscription">我的订阅 <text>→</text></view>
    </view>
  </view>

  <view class="upcoming-panel" wx:if="{{upcomingItems.length}}">
    <view class="section-heading">
      <view>
        <text class="section-title">近期事项</text>
        <text class="section-caption">按真实来源整理的报名与活动节点</text>
      </view>
    </view>
    <scroll-view scroll-x class="upcoming-scroll" enable-flex>
      <view
        class="upcoming-card"
        wx:for="{{upcomingItems}}"
        wx:key="_id"
        data-id="{{item._id}}"
        bindtap="openUpcoming"
      >
        <view class="upcoming-meta">
          <text class="upcoming-category">{{item.categoryText}}</text>
          <text class="upcoming-label">{{item.nodeLabel}}</text>
        </view>
        <text class="upcoming-title">{{item.title}}</text>
        <text class="upcoming-time">{{item.nodeTimeText}}</text>
        <text class="upcoming-source">{{item.sourceName}}</text>
      </view>
    </scroll-view>
  </view>

  <view class="feed-panel">
    <view class="section-heading feed-heading">
      <view>
        <text class="section-title">校园资讯</text>
        <text class="section-caption">按栏目查看公开来源和下一步行动</text>
      </view>
    </view>

    <scroll-view scroll-x class="category-scroll" enable-flex>
      <view
        wx:for="{{tags}}"
        wx:key="id"
        class="category-chip {{selectedTag === item.id ? 'active' : ''}}"
        data-tag="{{item.id}}"
        bindtap="onTagClick"
      >{{item.name}}</view>
    </scroll-view>

    <view class="skeleton-list" wx:if="{{loading && !list.length}}">
      <view class="skeleton-card skeleton" wx:for="{{[1,2,3]}}" wx:key="*this"></view>
    </view>

    <view class="content-list" wx:elif="{{list.length}}">
      <card-item
        wx:for="{{list}}"
        wx:key="_id"
        item="{{item}}"
        bind:favorite="onFavorite"
      />
      <view class="load-more" wx:if="{{loading}}">正在加载</view>
      <view class="load-more tappable" wx:elif="{{hasMore}}" bindtap="loadMore">加载更多</view>
      <view class="load-more" wx:else>已显示全部资讯</view>
    </view>

    <view class="empty-state" wx:else>
      <view class="empty-mark">i</view>
      <text class="empty-title">暂时没有相关资讯</text>
      <text class="empty-desc">可以换个栏目，或稍后重新检查真实来源。</text>
    </view>
  </view>
</view>
